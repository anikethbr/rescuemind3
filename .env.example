# Start with "demo" to use the clearly labelled sample incidents and local rules.
# Set to "gemini" to classify new intake using the Gemini API.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-e4b-it
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Set a long random value before exposing the dashboard publicly.
# Production startup requires at least 32 characters.
# The API requires it on all routes other than /api/health.
DASHBOARD_API_KEY=

# Demo command-centre location (Hyderabad). Set both to your real dispatch centre.
DISPATCH_BASE_LAT=17.3850
DISPATCH_BASE_LON=78.4867
MAX_IMAGE_BYTES=5242880
DATA_FILE=data/rescuemind.json
HOST=0.0.0.0
PORT=8000
